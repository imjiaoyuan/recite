{
  "name": "recite",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "自用英语背单词静态网站：四六级 / 考研 / 托福 / 雅思 / 读博，FSRS 间隔重复 + 拼写测试 + 例句",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:worker": "npm run build && wrangler deploy",
    "build:data": "node scripts/build-wordlists.js",
    "build:sentences": "node scripts/build-sentences.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "csv-parse": "^5.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.42.0"
  },
  "dependencies": {
    "ts-fsrs": "^5.4.1"
  }
}
