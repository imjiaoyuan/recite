{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "recite-sync",
  "main": "index.ts",
  "compatibility_date": "2025-01-01",
  // The site itself rides along as static assets. dist/ is built at the repo
  // root (and .gitignored — it's a build artifact); wrangler resolves
  // assets.directory relative to THIS config file, hence ../../dist. Build +
  // deploy from the root with `npm run deploy:worker`. Serving app + storage
  // from one origin is what removes the server-URL field from the UI — the KV
  // bound at deploy time IS the data store, and the served page is stamped so
  // it knows that.
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, matching asset requests are served directly by the assets
    // layer and NEVER reach the worker — so the <meta name="recite-sync"> stamp
    // (and the KV routes on asset-like paths) would silently never apply.
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "03dd6f9574134775988cfc88a7b940a5"
    }
  ],
  "vars": {
    "TOKEN": ""
  }
}
